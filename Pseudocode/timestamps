CLASS Timestamp

    DECLARE
    dayOfMonth (int)
    monthOfYear (int)
    year (int)
    hour (int)
    minute (int) 

     //default constructor
    PUBLIC METHOD Timestamp()
        dayOfMonth EQUALS NULL
        monthOfYear EQUALS NULL
        year EQUALS NULL
        hour EQUALS INT: ZERO
        minute EQUAlS new METHOD Timestamp()
    END METHOD

    //constructor with parameters
    PUBLIC METHOD Timestamp WITH PARAMATERS:
        dayOfMonth AS int,
        monthOfYear AS int,
        year AS int,
        hour AS int,
        minute AS Timestamp()
    END PARAMATERS -> START METHOD LOGIC
        this.dayOfMonth EQUALS dayOfMonth
        this.monthOfYear EQUALS monthOfYear
        this.year EQUALS year
        this.hour EQUALS hour
        this.minute EQUALS minute
    END METHOD
        
    //?
    PUBLIC METHOD Timestamp WITH PARAMETERS (DATATYPE: Timestamp SET TO "other")
        this.dayOfMonth EQUALS other.dayOfMonth
        this.monthOfYear EQUALS other.monthOfYear
        this.year EQUALS other.year
        this.hour EQUALS other.hour
        this.minute EQUALS new Timestamp(other.minute)
    END METHOD

    //--- ACCESSORS ---

    ACCESSOR: getdayOfMonth()
    IMPORT:
    EXPORT: dayOfMonth
    ASSERTION: get dayOfMonth
    ALGORITHM: RETURN dayOfMonth

    ACCESSOR: getmonthOfYear()
    IMPORT:
    EXPORT: monthOfYear
    ASSERTION: get monthOfYear
    ALGORITHM: RETURN monthOfYear

    ACCESSOR: getyear()
    IMPORT:
    EXPORT: year
    ASSERTION: get year
    ALGORITHM: RETURN year

    ACCESSOR: gethour()
    IMPORT:
    EXPORT: hour
    ASSERTION: get hour
    ALGORITHM: RETURN hour

    ACCESSOR: getTimestamp()
    IMPORT:
    EXPORT: Timestamp
    ASSERTION: get Timestamp
    ALGORITHM: RETURN Timestamp

    //--- MUTATORS ---

    MUTATOR: setdayOfMonth()
    Import: dayOfMonth (int)
    Export: 
    ASSERTION: Converts dayOfMonth (int) into this.dayOfMonth
    ALGORITHM: this.dayOfMonth EQUALS dayOfMonth

    MUTATOR: setmonthOfYear()
    Import: monthOfYear (int)
    Export:
    ASSERTION: Converts monthOfYear into this.monthOfYear
    ALGORITHM: this.monthOfYear EQUALS monthOfYear

    MUTATOR: setyear()
    Import: year (int)
    Export:
    ASSERTION: Converts year into this.year
    ALGORITHM: this.year EQUALS year

    MUTATOR: sethour()
    Import: hour (int)
    Export:
    ASSERTION: Converts hour into this.hour
    ALGORITHM: this.hour EQUALS hour

    MUTATOR: setTimestamp()
    Import: minute (DATATYPE: Timestamp)
    Export:
    ASSERTION: Converts timestmap into this.minute
    ALGORITHM: this.minute EQUALS minute

    //formatting 01/08/2026 (padding integers with zeros)
    DECLARE PUBLIC METHOD toString()
        RETURN 
            CALL METHOD pad() WITH PARAMETERS dayOfMonth PLUS "/" PLUS
            CALL METHOD pad() WITH PARAMETERS monthOfYear PLUS "/" PLUS
            CALL METHOD pad() WITH PARAMETERS year PLUS " " PLUS
            CALL METHOD pad() WITH PARAMETERS hour PLUS ":" PLUS
            CALL METHOD pad() WITH PARAMETERS minute 
        END RETURN
    END METHOD toString()

    DECLARE PRIVATE METHOD pad() as STRING WITH PARAMETERS (int n)
        RETURN  
            n IS SMALLER THAN 10
                IF TRUE: "0"
                IF FALSE: ""
        END RETURN
    END METHOD pad()

