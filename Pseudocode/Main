BEGIN PUBLIC CLASS Main

    DECLARE PRIVATE STATIC FINAL STRING: CSV_FILE = "data.csv"

    PUBLIC STATIC VOID main(String[] args)
        CALL Logger.open()                                              //open the log file

        DECLARE SensorArray: readings
        SET readings = CALL GreenhouseDataStorage.loadCSV(CSV_FILE)     //load every row of the CSV into a SensorArray

        DECLARE Menu: menu
        SET menu = NEW Menu(readings)                                   //hand the loaded readings to the menu
        CALL menu.run()                                                 //run the main menu loop until the user exits

        CALL Logger.close()                                             //close the log file
    END main()

END CLASS Main
