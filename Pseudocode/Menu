IMPORT java.io.BufferedReader, java.io.IOException, java.io.InputStreamReader


BEGIN PUBLIC CLASS Menu

    DECLARE PRIVATE STATIC FINAL STRING: CSV_FILE = "data.csv"

    DECLARE PRIVATE BufferedReader: consoleInputReader
    DECLARE PRIVATE SensorArray:    loadedReadings


    CONSTRUCTOR Menu(SensorArray loadedReadings)
        this.loadedReadings     = loadedReadings
        this.consoleInputReader = NEW BufferedReader(NEW InputStreamReader(System.in))
    END CONSTRUCTOR


    PUBLIC METHOD run() RETURN VOID
        DECLARE BOOLEAN: menuIsRunning = TRUE

        WHILE menuIsRunning EQUALS TRUE
            CALL Logger.logBlank()
            CALL Logger.logSeparator()
            CALL Logger.log("Welcome to the Smart Greenhouse monitoring system")
            CALL Logger.log("Please select an option: ")
            CALL Logger.log(" 1. Statistics for the entire Greenhouse")
            CALL Logger.log(" 2. Statistics by zone")
            CALL Logger.log(" 3. Statistics by sensor type")
            CALL Logger.log(" 4. Add data readings")
            CALL Logger.log(" 5. Delete data readings")
            CALL Logger.log(" 6. Exit program")
            CALL Logger.logSeparator()

            DECLARE INTEGER: userChoice = CALL readIntegerInRange("enter choice: ", 1, 6)

            IF userChoice EQUALS 1 THEN
                CALL handleOverallStats()
            ELSE IF userChoice EQUALS 2 THEN
                CALL handleStatsByZone()
            ELSE IF userChoice EQUALS 3 THEN
                CALL handleStatsByType()
            ELSE IF userChoice EQUALS 4 THEN
                CALL handleAddReading()
            ELSE IF userChoice EQUALS 5 THEN
                CALL handleDeleteReading()
            ELSE IF userChoice EQUALS 6 THEN
                menuIsRunning = FALSE
            END IF
        END WHILE
    END METHOD run()


    PRIVATE METHOD handleOverallStats() RETURN VOID
        CALL showStatsSubMenu(loadedReadings, "entire greenhouse")
    END METHOD handleOverallStats()


    PRIVATE METHOD handleStatsByZone() RETURN VOID
        DECLARE STRING ARRAY: availableZones = CALL loadedReadings.getDistinctZones()
        IF availableZones.length EQUALS 0 THEN
            CALL Logger.log("No zones available.")
        ELSE
            CALL Logger.logBlank()
            CALL Logger.log("Available zones:")
            FOR i = 0 TO availableZones.length - 1
                CALL Logger.log(" " + (i + 1) + ". " + availableZones[i])
            END FOR

            DECLARE INTEGER:     userSelection      = CALL readIntegerInRange("select zone: ", 1, availableZones.length)
            DECLARE STRING:      selectedZone       = availableZones[userSelection - 1]
            DECLARE SensorArray: filteredReadings   = CALL loadedReadings.filterByZone(selectedZone)
            CALL showStatsSubMenu(filteredReadings, "zone " + selectedZone)
        END IF
    END METHOD handleStatsByZone()


    PRIVATE METHOD handleStatsByType() RETURN VOID
        DECLARE STRING ARRAY: availableSensorTypes = CALL loadedReadings.getDistinctTypes()
        IF availableSensorTypes.length EQUALS 0 THEN
            CALL Logger.log("No sensor types available.")
        ELSE
            CALL Logger.logBlank()
            CALL Logger.log("Available sensor types:")
            FOR i = 0 TO availableSensorTypes.length - 1
                CALL Logger.log(" " + (i + 1) + ". " + availableSensorTypes[i])
            END FOR

            DECLARE INTEGER:     userSelection       = CALL readIntegerInRange("select type: ", 1, availableSensorTypes.length)
            DECLARE STRING:      selectedSensorType  = availableSensorTypes[userSelection - 1]
            DECLARE SensorArray: filteredReadings    = CALL loadedReadings.filterBySensorType(selectedSensorType)
            CALL showStatsSubMenu(filteredReadings, "type " + selectedSensorType)
        END IF
    END METHOD handleStatsByType()


    PRIVATE METHOD handleAddReading() RETURN VOID
        CALL Logger.logBlank()
        DECLARE STRING:  sensorID    = CALL readNonEmptyString("sensor ID: ")
        DECLARE STRING:  sensorType  = CALL readValidSensorType()
        DECLARE STRING:  zone        = CALL readNonEmptyString("zone: ")
        DECLARE DOUBLE:  sensorValue = CALL readDoubleNumber("value: ")
        DECLARE INTEGER: day         = CALL readIntegerInRange("day (1-31): ",        1,    31)
        DECLARE INTEGER: month       = CALL readIntegerInRange("month (1-12): ",      1,    12)
        DECLARE INTEGER: year        = CALL readIntegerInRange("year (2000-2100): ",  2000, 2100)
        DECLARE INTEGER: hour        = CALL readIntegerInRange("hour (0-23): ",       0,    23)
        DECLARE INTEGER: minute      = CALL readIntegerInRange("minute (0-59): ",     0,    59)

        DECLARE Timestamp:     newReadingTimestamp = NEW Timestamp(day, month, year, hour, minute)
        DECLARE SensorReading: newReading          = NEW SensorReading(sensorID, sensorType, zone, sensorValue, newReadingTimestamp)
        CALL loadedReadings.add(newReading)
        CALL GreenhouseDataStorage.saveCSV(CSV_FILE, loadedReadings)        //persist immediately so we don't lose the new row
        CALL Logger.log("Reading added: " + newReading)
    END METHOD handleAddReading()


    PRIVATE METHOD handleDeleteReading() RETURN VOID
        IF loadedReadings.getCount() EQUALS 0 THEN
            CALL Logger.log("No readings to delete.")
        ELSE
            CALL Logger.logBlank()
            FOR i = 0 TO loadedReadings.getCount() - 1
                CALL Logger.log(" " + (i + 1) + ". " + loadedReadings.get(i))
            END FOR

            DECLARE INTEGER:       userSelection   = CALL readIntegerInRange("select reading to delete: ", 1, loadedReadings.getCount())
            DECLARE SensorReading: removedReading  = CALL loadedReadings.get(userSelection - 1)
            CALL loadedReadings.deleteAt(userSelection - 1)
            CALL GreenhouseDataStorage.saveCSV(CSV_FILE, loadedReadings)    //persist immediately after the delete
            CALL Logger.log("Deleted: " + removedReading)
        END IF
    END METHOD handleDeleteReading()


    PRIVATE METHOD showStatsSubMenu(SensorArray filteredReadings, STRING contextLabel) RETURN VOID
        CALL Logger.logBlank()
        CALL Logger.log("Statistics for " + contextLabel + ":")
        CALL Logger.log(" 1. Total number of readings")
        CALL Logger.log(" 2. Average value")
        CALL Logger.log(" 3. Minimum value")
        CALL Logger.log(" 4. Maximum value")
        CALL Logger.log(" 5. Number of readings outside safe range")
        CALL Logger.log(" 6. Percentage of readings outside safe range")
        CALL Logger.log(" 7. All statistics")

        DECLARE INTEGER: userChoice = CALL readIntegerInRange("enter choice: ", 1, 7)

        IF userChoice EQUALS 1 THEN
            CALL Logger.log("Total: " + filteredReadings.totalReadings())
        ELSE IF userChoice EQUALS 2 THEN
            CALL Logger.log("Average: " + filteredReadings.average())
        ELSE IF userChoice EQUALS 3 THEN
            CALL Logger.log("Minimum: " + filteredReadings.minimum())
        ELSE IF userChoice EQUALS 4 THEN
            CALL Logger.log("Maximum: " + filteredReadings.maximum())
        ELSE IF userChoice EQUALS 5 THEN
            CALL Logger.log("Out of range: " + filteredReadings.outOfRangeCount())
        ELSE IF userChoice EQUALS 6 THEN
            CALL Logger.log("Out of range %: " + filteredReadings.outOfRangePercent())
        ELSE IF userChoice EQUALS 7 THEN
            CALL Logger.log("Total: " + filteredReadings.totalReadings())
            CALL Logger.log("Average: " + filteredReadings.average())
            CALL Logger.log("Minimum: " + filteredReadings.minimum())
            CALL Logger.log("Maximum: " + filteredReadings.maximum())
            CALL Logger.log("Out of range: " + filteredReadings.outOfRangeCount())
            CALL Logger.log("Out of range %: " + filteredReadings.outOfRangePercent())
        END IF
    END METHOD showStatsSubMenu()


    PRIVATE METHOD readLineFromConsole(STRING promptToShow) RETURN STRING
        PRINT promptToShow (no newline)
        DECLARE STRING: trimmedInputLine = ""
        TRY
            DECLARE STRING: rawInputLine = READ LINE FROM consoleInputReader
            IF rawInputLine EQUALS NULL THEN
                trimmedInputLine = ""
            ELSE
                trimmedInputLine = rawInputLine.trim()
            END IF
        CATCH IOException inputError
            trimmedInputLine = ""
        END TRY
        RETURN trimmedInputLine
    END METHOD readLineFromConsole()


    PRIVATE METHOD readIntegerInRange(STRING promptToShow, INTEGER minimumAllowedValue, INTEGER maximumAllowedValue) RETURN INTEGER
        DECLARE INTEGER: validatedInteger = 0
        DECLARE BOOLEAN: inputAccepted    = FALSE
        WHILE inputAccepted EQUALS FALSE
            DECLARE STRING: userInputString = CALL readLineFromConsole(promptToShow)
            IF Validator.isInteger(userInputString) EQUALS TRUE THEN
                DECLARE INTEGER: parsedInteger = PARSE userInputString TO INTEGER
                IF parsedInteger >= minimumAllowedValue AND parsedInteger <= maximumAllowedValue THEN
                    validatedInteger = parsedInteger
                    inputAccepted    = TRUE
                ELSE
                    CALL Logger.log("Please enter an integer between " + minimumAllowedValue + " and " + maximumAllowedValue + ".")
                END IF
            ELSE
                CALL Logger.log("Please enter an integer between " + minimumAllowedValue + " and " + maximumAllowedValue + ".")
            END IF
        END WHILE
        RETURN validatedInteger
    END METHOD readIntegerInRange()


    PRIVATE METHOD readDoubleNumber(STRING promptToShow) RETURN DOUBLE
        DECLARE DOUBLE:  validatedDouble = 0.0
        DECLARE BOOLEAN: inputAccepted   = FALSE
        WHILE inputAccepted EQUALS FALSE
            DECLARE STRING: userInputString = CALL readLineFromConsole(promptToShow)
            IF Validator.isNumeric(userInputString) EQUALS TRUE THEN
                validatedDouble = PARSE userInputString TO DOUBLE
                inputAccepted   = TRUE
            ELSE
                CALL Logger.log("Please enter a number.")
            END IF
        END WHILE
        RETURN validatedDouble
    END METHOD readDoubleNumber()


    PRIVATE METHOD readNonEmptyString(STRING promptToShow) RETURN STRING
        DECLARE STRING:  validatedString = ""
        DECLARE BOOLEAN: inputAccepted   = FALSE
        WHILE inputAccepted EQUALS FALSE
            DECLARE STRING: userInputString = CALL readLineFromConsole(promptToShow)
            IF userInputString.length() > 0 THEN
                validatedString = userInputString
                inputAccepted   = TRUE
            ELSE
                CALL Logger.log("Value cannot be empty.")
            END IF
        END WHILE
        RETURN validatedString
    END METHOD readNonEmptyString()


    PRIVATE METHOD readValidSensorType() RETURN STRING
        DECLARE STRING:  validatedSensorType = ""
        DECLARE BOOLEAN: inputAccepted       = FALSE
        WHILE inputAccepted EQUALS FALSE
            DECLARE STRING: userInputString = CALL readLineFromConsole("sensor type (temperature/humidity/soilMoisture/light): ")
            IF Validator.isValidSensorType(userInputString) EQUALS TRUE THEN
                validatedSensorType = userInputString
                inputAccepted       = TRUE
            ELSE
                CALL Logger.log("Invalid sensor type.")
            END IF
        END WHILE
        RETURN validatedSensorType
    END METHOD readValidSensorType()

END CLASS Menu
