BEGIN PUBLIC CLASS SensorArray

        DECLARE PRIVATE ARRAY: SensorReading[], NAMED "data"
        DECLARE PRIVATE INTEGER NAMED count

        SET INITIAL_CAPACITY (INTEGER) TO EQAUL 100
        SET GROWTH_FACTOR (INTEGER) TO EQAUL 2

        DECLARE PUBLIC METHOD SensorArray()
            NEW METHOD CALL sensorReading WITH PARAMATERS INITIAL_CAPACITY -> SET TO "data"
            INITIALISE count EQUAL TO "0"
        END METHOD SensorArray()

        DECLARE PUBLIC METHOD add() WITH PARAMATERS "reading" -> DATATYPE SensorReading (RETURN NOTHING)
            IF "count" IS EQUAL TO LENGTH OF "data"                                                              //syntax -> if (count == data.length)
                CALL METHOD: resize()
            END IF
            INITIALISE ARRAY "data" WITH ARGUMENTS "count" SET EQUAL TO "reading"
            CALL "count" ADD ONE                                                                                 //syntax -> count++
        END METHOD add()

        CALL PUBLIC METHOD deleteAt() WITH PARAMATERS "index" (INT) (RETURN NOTHING)
            IF "index" IS LESS THAN 0 OR "index" IS GREATER THAN OR EQUAL TO "count"
                CALL NEW METHOD IllegalArgumentException() WITH PARAMATERS "Index out of bounds: " + index      //syntax -> throw new (method call)
            END IF
            USE SYSTEM CLASS AND CALL .arraycopy() WITH ARGUMENTS (SOURCE: "data", SOURCE POSITION: "index PLUS 1", DESTINATION: "data", DESTINATION POSITION: "index", LENGTH: "count MINUS index MINUS 1")
            DECREMENT count BY 1
            CALL data ARRAY WITH ARGUMENT count, SET EQUAL TO NULL
        END METHOD deleteAt()

        CALL PUBLIC METHOD get() <- DATATYPE SensorReading WTIH ARGUMENTS "index" (INTEGER) 
            IF "index" IS LESS THAN 0 OR "index" IS GREATER THAN OR EQUAL TO "count"
                CALL NEW METHOD IllegalArgumentException() WITH PARAMATERS "Index out of bounds: " + index      //syntax -> throw new (method call)
            END IF
            RETURN data ARRAY WITH ARGUMENT "index"
        END METHOD get()

        CALL METHOD getCount() <- DATATYPE: INTEGER
            RETURN count
        END METHOD getCount()

        //check zone 
        CALL PUBLIC METHOD filterByZone() <- DATATYPE: SensorArray WITH ARGUMENTS zone <- DATATYPE: String
            DECLARE NEW OBJECT NAMED "result" <- DATATYPE: SensorArray
            FOR LOOP TO START COUNTING AT 0, KEEP GOING UNTIL EVERY INDEX IS HIT, INCREMENT "i" BY 1 EVERY ROUND
                IF CURRENT ZONE IS EQUAL TO CHOSEN ZONE
                    ADD DATA TO "result"
                END IF
            END FOR LOOP
            RETURN "result"
        END METHOD filterByZone()

        //check type
         CALL PUBLIC METHOD filterBySensorType() <- DATATYPE: SensorArray WITH ARGUMENTS type <- DATATYPE: String
            DECLARE NEW OBJECT NAMED "result" <- DATATYPE: SensorArray
            FOR LOOP TO START COUNTING AT 0, KEEP GOING UNTIL EVERY INDEX IS HIT, INCREMENT "i" BY 1 EVERY ROUND
                IF CURRENT TYPE IS EQUAL TO CHOSEN TYPE
                    ADD DATA TO "result"
                END IF
            END FOR LOOP
            RETURN "result"
        END METHOD filterBySensorType()

        CALL PUBLIC METHOD toArray() <- DATATYPE: SensorReading ARRAY
            DECLARE NEW OBJECT NAMED "trimmed" <- DATATYPE: SensorReading ARRAY WITH "count" AS ARGUMENTS
            USE SYSTEM CLASS AND CALL .arraycopy() WITH ARGUMENTS (SOURCE: "data", SOURCE POSITION: "0", DESTINATION: "trimmed", DESTINATION POSITION: "0", LENGTH: "count")
            RETURN "trimmed"
        END METHOD toArray()

        CALL PUBLIC CLASS totalReadings() <- DATATYPE: INTEGER
            RETURN "count"
        END METHOD totalReadings()

        CALL METHOD average() <- DATATYPE: DOUBLE
            IF "count" EQUALS TO 0 
                RETURN 0.0
            END IF
            ELSE "sum" EQUALS TO 0.0
            END ELSE
            FOR LOOP TO START COUNTING AT INDEX 0, KEEP GOING UNTIL EVERY INDEX AS LONG AS "count" HIT, INCREMENT "i" BY 1 EVERY ROUND
                INCREMENT AND EQUAL "sum" BY INDEX
            END FOR LOOP
            RETURN "sum" DIVIDED BY "count"
        END METHOD average()

        CALL METHOD minimum() <- DATATYPE: DOUBLE
            IF "count" EQUALS TO 0 
                RETURN 0.0
            END IF
            ELSE
            DATATYPE: DOUBLE: "min" EQUALS TO INDEX 0 USING getValue()
            END ELSE
            FOR LOOP TO START COUNTING AT INDEX 1, KEEP GOING UNTIL EVERY INDEX AS LONG AS "count" IS HIT, INCREMENT "i" BY 1 EVERY ROUND
                IF INDEX IN "data" IS LESS THAN "min" 
                    THEN "min" EQUALS TO INDEXED VALUE
                END IF
            RETURN "min"
            END FOR LOOP
        END METHOD minimum()

        CALL METHOD maximum() <- DATATYPE: DOUBLE
            IF "count" EQUALS TO 0 
                RETURN 0.0
            END IF
            ELSE
            DATATYPE: DOUBLE: "max" EQUALS TO INDEX 0 USING getValue()
            END ELSE
            FOR LOOP TO START COUNTING AT INDEX 1, KEEP GOING UNTIL EVERY INDEX AS LONG AS "count" IS HIT, INCREMENT "i" BY 1 EVERY ROUND
                IF INDEX IN "data" IS GREATER THAN "max" 
                    THEN "max" EQUALS TO INDEXED VALUE
                END IF
            RETURN "max"
            END FOR LOOP
        END METHOD maximum()

        CALL PUBLIC METHOD outOfRangeCount() <- DATATYPE: INTEGER
            "n" EQUALS 0
            FOR LOOP TO START COUNTING AT INDEX 0, KEEP GOING UNTIL EVERY INDEX AS LONG AS "count" IS HIT, INCREMENT "i" BY 1 EVERY ROUND
                IF INDEX IN "data" IS OUT OF RANGE                      //syntax <- data[i].isOutOfRange() 
                    THEN INCREMENT "N" by 1
            END FOR LOOP
            RETURN "n"
        END METHOD outOfRangeCount()

        CALL PUBLIC METHOD outOfRangePercent() <- DATATYPE: DOUBLE
            IF "count" IS EQUAL TO 0
                RETURN 0.0                                                //exit function if RETURN is called
            END IF
            ELSE
            RETURN (DOUBLE: outOfRangeCount() / count) * 100.0 
            END ELSE
        END METHOD outOfRangePercent()

        CALL METHOD getDistinctZones() <- DATATYPE: STRING ARRAY
            DECLARE NEW OBJECT NAMED "allZones" <- DATATYPE: STRING ARRAY WITH ARGUMENTS "count"
            FOR LOOP TO START COUNTING AT INDEX 0, KEEP GOING UNTIL EVERY INDEX AS LONG AS "count" IS HIT, INCREMENT "i" BY 1 EVERY ROUND
                CURRENT INDEX of "allZones" EQUALS DATA IN getZone() METHOD
            RETURN distinctValues() <- WITH ARGUMENTS "allZones"
        END METHOD

        CALL METHOD getDistinctTypes() <- DATATYPE: STRING ARRAY
            DECLARE NEW OBJECT NAMED "allTypes" <- DATATYPE: STRING ARRAY WITH ARGUMENTS "count"
            FOR LOOP TO START COUNTING AT INDEX 0, KEEP GOING UNTIL EVERY INDEX AS LONG AS "count" IS HIT, INCREMENT "i" BY 1 EVERY ROUND
                CURRENT INDEX of "allTypes" EQUALS DATA IN getSensorType() METHOD
            RETURN distinctValues() <- WITH ARGUMENTS "allTypes"
        END METHOD

        CALL PRIVATE METHOD distinctValues() <- WITH ARGUMENTS "allValues"
            DECLARE NEW OBJECT NAMED "result" <- DATATYPE: STRING ARRAY WITH ARGUMENTS "count"
            SET "uniqueCount" EQUAL TO 0 (INTEGER)
            FOR LOOP TO START COUNTING AT INDEX 0, KEEP GOING UNTIL EVERY INDEX AS LONG AS LENGTH OF allValues, INCREMENT "i" BY 1 EVERY ROUND
                SET "found" EQUAL TO FALSE <- DATATYPE: BOOLEAN
                    FOR LOOP TO START COUNTING AT INDEX 0, KEEP GOING UNTIL EVERY INDEX AS LONG AS "uniqueCount", INCREMENT "j" BY 1 EVERY ROUND
                        IF result[j] EQUALS INDEX AT allValues[i]
                            SET "found" EQUAL TO TRUE
                            BREAK
                        IF "found" IS FALSE
                            SET result[uniqueCount] TO allValues[i]
                            INCREMENT uniqueCount BY 1
                        DECLARE "trimmed" AS STRING ARRAY OF SIZE "uniqueCount"
                        COPY first "uniqueCount" elements FROM "result" INTO "trimmed"
                        RETURN "trimmed"
        END METHOD

        CALL PRIVATE METHOD resize()
        DECLARE "newData" AS SensorReading ARRAY OF SIZE (data.length MULTIPLIED BY GROWTH_FACTOR)
        COPY "count" ELEMENTS FROM "data" STARTING AT INDEX 0 INTO "newData" STARTING AT INDEX 0
        SET "data" TO "newData"
        END METHOD



