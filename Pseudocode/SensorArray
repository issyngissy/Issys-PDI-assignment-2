BEGIN PUBLIC CLASS SensorArray

    DECLARE PRIVATE STATIC FINAL INTEGER INITIAL_CAPACITY = 100
    DECLARE PRIVATE STATIC FINAL INTEGER CAPACITY_GROWTH_FACTOR = 2

    DECLARE PRIVATE ARRAY OF SensorReading readings
    DECLARE PRIVATE INTEGER numberOfReadings


    CONSTRUCTOR SensorArray()
        SET readings = NEW SensorReading ARRAY WITH SIZE INITIAL_CAPACITY
        SET numberOfReadings = 0
    END CONSTRUCTOR


    PUBLIC METHOD add(SensorReading newReading)
        IF numberOfReadings EQUALS readings.length THEN
            CALL growArray()
        END IF

        SET readings[numberOfReadings] = newReading
        SET numberOfReadings = numberOfReadings + 1
    END METHOD


    PUBLIC METHOD deleteAt(INTEGER indexToDelete)
        IF indexToDelete < 0 OR indexToDelete >= numberOfReadings THEN
            THROW IllegalArgumentException
        END IF

        FOR i = indexToDelete TO numberOfReadings - 2
            SET readings[i] = readings[i + 1]
        END FOR

        SET numberOfReadings = numberOfReadings - 1
        SET readings[numberOfReadings] = NULL
    END METHOD


    PUBLIC METHOD get(INTEGER indexToFetch) RETURNS SensorReading
        IF indexToFetch < 0 OR indexToFetch >= numberOfReadings THEN
            THROW IllegalArgumentException
        END IF

        RETURN readings[indexToFetch]
    END METHOD


    PUBLIC METHOD getCount() RETURNS INTEGER
        RETURN numberOfReadings
    END METHOD


    PUBLIC METHOD hasSensorID(STRING sensorIDToFind) RETURNS BOOLEAN
        DECLARE BOOLEAN sensorIDAlreadyExists = FALSE

        FOR i = 0 TO numberOfReadings - 1
            IF readings[i].getSensorID() EQUALS sensorIDToFind THEN
                SET sensorIDAlreadyExists = TRUE
            END IF
        END FOR

        RETURN sensorIDAlreadyExists
    END METHOD


    PUBLIC METHOD filterByZone(STRING zoneToMatch) RETURNS SensorArray
        DECLARE SensorArray matchingReadings = NEW SensorArray()

        FOR i = 0 TO numberOfReadings - 1
            IF readings[i].getZone() EQUALS zoneToMatch THEN
                CALL matchingReadings.add(readings[i])
            END IF
        END FOR

        RETURN matchingReadings
    END METHOD


    PUBLIC METHOD filterBySensorType(STRING typeToMatch) RETURNS SensorArray
        DECLARE SensorArray matchingReadings = NEW SensorArray()

        FOR i = 0 TO numberOfReadings - 1
            IF readings[i].getSensorType() EQUALS typeToMatch THEN
                CALL matchingReadings.add(readings[i])
            END IF
        END FOR

        RETURN matchingReadings
    END METHOD


    PRIVATE METHOD growArray()
        DECLARE INTEGER expandedCapacity = readings.length * CAPACITY_GROWTH_FACTOR
        DECLARE ARRAY OF SensorReading expandedReadings = NEW SensorReading ARRAY WITH SIZE expandedCapacity

        FOR i = 0 TO numberOfReadings - 1
            SET expandedReadings[i] = readings[i]
        END FOR

        SET readings = expandedReadings
    END METHOD

END CLASS
