BEGIN PUBLIC CLASS GreenhouseDataStorage

    PUBLIC STATIC METHOD loadCSV(STRING csvFilename) RETURNS SensorArray
        DECLARE SensorArray loadedReadings = NEW SensorArray()
        DECLARE BufferedReader csvReader = NULL

        TRY
            SET csvReader = OPEN csvFilename FOR READING
            READ AND IGNORE FIRST LINE

            DECLARE INTEGER currentLineNumber = 1
            DECLARE STRING currentLine = READ LINE FROM csvReader

            WHILE currentLine IS NOT NULL
                SET currentLineNumber = currentLineNumber + 1
                SET currentLine = currentLine.trim()

                IF currentLine.length() > 0 THEN
                    DECLARE SensorReading parsedReading = CALL parseLine(currentLine)

                    IF parsedReading IS NOT NULL THEN
                        CALL loadedReadings.add(parsedReading)
                    ELSE
                        PRINT "Warning: skipped invalid row " + currentLineNumber
                    END IF
                END IF

                SET currentLine = READ LINE FROM csvReader
            END WHILE

        CATCH IOException
            PRINT "Error loading file"
        END TRY

        IF csvReader IS NOT NULL THEN
            CLOSE csvReader
        END IF

        RETURN loadedReadings
    END METHOD


    PUBLIC STATIC METHOD saveCSV(STRING csvFilename, SensorArray readingsToSave)
        DECLARE BufferedWriter csvWriter = NULL

        TRY
            SET csvWriter = OPEN csvFilename FOR WRITING IN OVERWRITE MODE
            WRITE "day,month,year,hour,minute,sensorID,sensorType,zone,value"
            WRITE NEW LINE

            FOR i = 0 TO readingsToSave.getCount() - 1
                DECLARE SensorReading currentReading = CALL readingsToSave.get(i)
                DECLARE Timestamp currentTimestamp = CALL currentReading.getTimestamp()

                DECLARE STRING csvLine =
                    currentTimestamp.getDayOfMonth() + "," +
                    currentTimestamp.getMonthOfYear() + "," +
                    currentTimestamp.getYear() + "," +
                    currentTimestamp.getHour() + "," +
                    currentTimestamp.getMinute() + "," +
                    currentReading.getSensorID() + "," +
                    currentReading.getSensorType() + "," +
                    currentReading.getZone() + "," +
                    currentReading.getValue()

                WRITE csvLine
                WRITE NEW LINE
            END FOR

        CATCH IOException
            PRINT "Error saving file"
        END TRY

        IF csvWriter IS NOT NULL THEN
            CLOSE csvWriter
        END IF
    END METHOD


    PRIVATE STATIC METHOD parseLine(STRING csvLine) RETURNS SensorReading
        DECLARE SensorReading parsedReading = NULL
        DECLARE STRING ARRAY csvFields = NULL

        IF csvLine IS NOT NULL THEN
            SET csvFields = SPLIT csvLine BY "," KEEPING EMPTY FIELDS
        END IF

        IF csvFields EXISTS AND csvFields.length EQUALS 9 THEN
            DECLARE STRING dayString = csvFields[0].trim()
            DECLARE STRING monthString = csvFields[1].trim()
            DECLARE STRING yearString = csvFields[2].trim()
            DECLARE STRING hourString = csvFields[3].trim()
            DECLARE STRING minuteString = csvFields[4].trim()
            DECLARE STRING sensorID = csvFields[5].trim()
            DECLARE STRING sensorType = csvFields[6].trim()
            DECLARE STRING zone = csvFields[7].trim()
            DECLARE STRING valueString = csvFields[8].trim()

            DECLARE BOOLEAN rowIsValid = TRUE

            IF Validator.isInteger(dayString) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
            IF Validator.isInteger(monthString) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
            IF Validator.isInteger(yearString) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
            IF Validator.isInteger(hourString) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
            IF Validator.isInteger(minuteString) EQUALS FALSE THEN SET rowIsValid = FALSE END IF

            IF rowIsValid EQUALS TRUE THEN
                DECLARE INTEGER day = PARSE dayString AS INTEGER
                DECLARE INTEGER month = PARSE monthString AS INTEGER
                DECLARE INTEGER year = PARSE yearString AS INTEGER
                DECLARE INTEGER hour = PARSE hourString AS INTEGER
                DECLARE INTEGER minute = PARSE minuteString AS INTEGER

                IF Validator.isValidDay(day) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isValidMonth(month) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isValidYear(year) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isValidHour(hour) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isValidMinute(minute) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isValidSensorID(sensorID) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isValidSensorType(sensorType) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isValidZone(zone) EQUALS FALSE THEN SET rowIsValid = FALSE END IF
                IF Validator.isNumeric(valueString) EQUALS FALSE THEN SET rowIsValid = FALSE END IF

                IF rowIsValid EQUALS TRUE THEN
                    DECLARE DOUBLE sensorValue = PARSE valueString AS DOUBLE
                    DECLARE Timestamp readingTimestamp = NEW Timestamp(day, month, year, hour, minute)
                    SET parsedReading = NEW SensorReading(sensorID, sensorType, zone, sensorValue, readingTimestamp)
                END IF
            END IF
        END IF

        RETURN parsedReading
    END METHOD

END CLASS
