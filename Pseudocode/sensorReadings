BEGIN PUBLIC CLASS SensorReading

    DECLARE PRIVATE STRING sensorID
    DECLARE PRIVATE STRING sensorType
    DECLARE PRIVATE STRING zone
    DECLARE PRIVATE DOUBLE value
    DECLARE PRIVATE Timestamp timestamp


    CONSTRUCTOR SensorReading()
        SET sensorID = ""
        SET sensorType = ""
        SET zone = ""
        SET value = 0.0
        SET timestamp = NEW Timestamp()
    END CONSTRUCTOR


    CONSTRUCTOR SensorReading(STRING sensorID, STRING sensorType, STRING zone, DOUBLE value, Timestamp timestamp)
        SET this.sensorID = sensorID
        SET this.sensorType = sensorType
        SET this.zone = zone
        SET this.value = value
        SET this.timestamp = timestamp
    END CONSTRUCTOR


    CONSTRUCTOR SensorReading(SensorReading sourceReading)
        SET this.sensorID = sourceReading.sensorID
        SET this.sensorType = sourceReading.sensorType
        SET this.zone = sourceReading.zone
        SET this.value = sourceReading.value
        SET this.timestamp = NEW Timestamp(sourceReading.timestamp)
    END CONSTRUCTOR


    PUBLIC METHOD getSensorID() RETURNS STRING
        RETURN sensorID
    END METHOD

    PUBLIC METHOD getSensorType() RETURNS STRING
        RETURN sensorType
    END METHOD

    PUBLIC METHOD getZone() RETURNS STRING
        RETURN zone
    END METHOD

    PUBLIC METHOD getValue() RETURNS DOUBLE
        RETURN value
    END METHOD

    PUBLIC METHOD getTimestamp() RETURNS Timestamp
        RETURN timestamp
    END METHOD


    PUBLIC METHOD setSensorID(STRING sensorID)
        SET this.sensorID = sensorID
    END METHOD

    PUBLIC METHOD setSensorType(STRING sensorType)
        SET this.sensorType = sensorType
    END METHOD

    PUBLIC METHOD setZone(STRING zone)
        SET this.zone = zone
    END METHOD

    PUBLIC METHOD setValue(DOUBLE value)
        SET this.value = value
    END METHOD

    PUBLIC METHOD setTimestamp(Timestamp timestamp)
        SET this.timestamp = timestamp
    END METHOD


    PRIVATE STATIC METHOD getSafeRange(STRING sensorTypeToLookUp) RETURNS ARRAY OF DOUBLE
        DECLARE ARRAY OF DOUBLE safeRangeBounds = NULL

        IF sensorTypeToLookUp EQUALS "temperature" THEN
            SET safeRangeBounds = {18.0, 30.0}
        ELSE IF sensorTypeToLookUp EQUALS "humidity" THEN
            SET safeRangeBounds = {40.0, 70.0}
        ELSE IF sensorTypeToLookUp EQUALS "soilMoisture" THEN
            SET safeRangeBounds = {30.0, 60.0}
        ELSE IF sensorTypeToLookUp EQUALS "light" THEN
            SET safeRangeBounds = {300.0, 1200.0}
        END IF

        RETURN safeRangeBounds
    END METHOD


    PUBLIC METHOD isOutOfRange() RETURNS BOOLEAN
        DECLARE BOOLEAN readingIsOutOfRange = FALSE
        DECLARE ARRAY OF DOUBLE safeRangeBounds = CALL getSafeRange(sensorType)

        IF safeRangeBounds IS NULL THEN
            SET readingIsOutOfRange = FALSE
        ELSE IF value < safeRangeBounds[0] THEN
            SET readingIsOutOfRange = TRUE
        ELSE IF value > safeRangeBounds[1] THEN
            SET readingIsOutOfRange = TRUE
        ELSE
            SET readingIsOutOfRange = FALSE
        END IF

        RETURN readingIsOutOfRange
    END METHOD


    PUBLIC METHOD toString() RETURNS STRING
        DECLARE STRING timestampPrefix = "[" + timestamp.toString() + "] "
        DECLARE STRING readingDetails = sensorID + " (" + sensorType + ", " + zone + "): " + value
        RETURN timestampPrefix + readingDetails
    END METHOD

END CLASS
