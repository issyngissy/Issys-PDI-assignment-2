IMPORT java.io.BufferedWriter, java.io.FileWriter, java.io.IOException


BEGIN PUBLIC CLASS Logger

    DECLARE PRIVATE STATIC FINAL STRING: LOG_FILE_NAME = "logged_data"
    DECLARE PRIVATE STATIC BufferedWriter: logFileWriter = NULL


    PUBLIC STATIC METHOD open() RETURN VOID
        TRY
            logFileWriter = NEW BufferedWriter(NEW FileWriter(LOG_FILE_NAME, TRUE))    //open the log file in append mode
            CALL logFileWriter.write("starting session...")
            CALL logFileWriter.newLine()
            CALL logFileWriter.flush()
        CATCH Exception fileOpenError
            PRINT "could not open log file..."
            logFileWriter = NULL                                                       //reset writer so log() knows the file is not open
        END TRY
    END METHOD open()


    //Called every time we want a message printed to console AND written to the log file
    PUBLIC STATIC METHOD log(STRING messageToLog) RETURN VOID
        PRINT messageToLog                                                             //print to console
        IF logFileWriter DOES NOT EQUAL NULL THEN
            TRY
                CALL logFileWriter.write(messageToLog)
                CALL logFileWriter.newLine()
                CALL logFileWriter.flush()
            CATCH IOException fileWriteError
                //ignore so the program keeps running even if logging fails
            END TRY
        END IF
    END METHOD log()


    PUBLIC STATIC METHOD logBlank() RETURN VOID
        CALL log("")                                                                   //log an empty line
    END METHOD logBlank()


    PUBLIC STATIC METHOD logSeparator() RETURN VOID
        CALL log("----------------------------------------")                           //log a divider line
    END METHOD logSeparator()


    PUBLIC STATIC METHOD close() RETURN VOID
        IF logFileWriter DOES NOT EQUAL NULL THEN
            TRY
                CALL logFileWriter.write("ending session")
                CALL logFileWriter.newLine()
                CALL logFileWriter.newLine()                                            //extra blank line between sessions
                CALL logFileWriter.flush()
                CALL logFileWriter.close()
            CATCH IOException fileCloseError
                //ignore - nothing we can do if closing fails
            END TRY
        END IF
    END METHOD close()

END CLASS Logger
